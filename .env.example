# .env.example — 所有变量及其默认值
#
# 复制本文件为 .env 后修改：
#   cp .env.example .env

# === TronEcho 事件监听 ===
# TronEcho 用于监听链上 USDT 转账事件，到账后自动更新用户余额
# 项目地址：https://github.com/jerryshell/tronecho
TRONECHO_NATS_URL=nats://127.0.0.1:4222  # TronEcho 连接的 NATS 地址
TRONECHO_PREFIX=tronecho                  # NATS JetStream 主题前缀，需与 tronecho 配置一致

# === MPC 钱包 ===
# MPC (多方计算) 钱包用于为每个用户生成独立的 TRC20 USDT 充值地址
# 项目地址：https://github.com/fystack/mpcium
MPC_NATS_URL=nats://127.0.0.1:4222       # MPC 服务连接的 NATS 地址
MPC_KEY_PATH=./event_initiator.key        # MPC 事件发起者私钥文件路径

# === TRON 网络 ===
# nile = 测试网 (推荐开发使用)
# mainnet = 主网 (正式环境)
TRON_NETWORK=nile

# === TronGrid API ===
# 用于查询链上数据，可从 https://www.trongrid.io/ 申请
TRONGRID_API_KEY=

# === Gas 池 ===
# 用于支付 TRX 手续费 (能量/带宽)，将 USDT 从用户地址归集到主地址时需要消耗 TRX
# 请使用专用地址，不要存放大量资产
GAS_POOL_PRIVATE_KEY=
